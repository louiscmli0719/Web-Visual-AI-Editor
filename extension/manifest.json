{
  "manifest_version": 3,
  "name": "Web Visual AI Editor",
  "description": "Select page elements, collect visual edit comments, and export structured prompts or JSON.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Toggle Web Visual AI Editor"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}

